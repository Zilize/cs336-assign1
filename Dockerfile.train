# syntax=docker/dockerfile:1.7
# 用于在 k8s GPU 节点上做训练的镜像。
# 直接用 PyTorch 官方镜像：torch + CUDA 12.6 + cuDNN 都预装好，兼容节点的 535 驱动
# (CUDA 12.2，走 CUDA 12 同大版本 minor 兼容)，不用再下载 torch wheel。
FROM pytorch/pytorch:2.11.0-cuda12.6-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_BREAK_SYSTEM_PACKAGES=1

WORKDIR /app

# torch 已由基础镜像提供，这里只装其余依赖（requirements 里已不含 torch），走清华源
COPY requirements-train.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-train.txt

COPY moellm ./moellm
COPY train.py utils.py ./
COPY train_distributed.py ./
COPY pyproject.toml ./

ENV PYTHONPATH=/app
